# Secrets
.env
*.pem
*.token
tokens/

# Data: snapshots, sqlite, anything the jobs write.
# data/* rather than data/ so the negation below can still re-include the placeholder.
data/*
!data/.gitkeep

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# Frontend
node_modules/
frontend/dist/

# Generated by `optscan shortcut`. Not committed: it bakes in the configured host and
# port and the absolute path to this machine's venv, so a checked in copy would be
# wrong on any other machine and stale after any config change.
scripts/optscan-dashboard.cmd

# Editors and OS
.vscode/
.idea/
Thumbs.db
desktop.ini
