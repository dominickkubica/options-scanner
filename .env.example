# Copy to .env and edit. .env is gitignored and must stay that way.
# Every variable is optional: the defaults in src/optscan/config.py apply otherwise.

OPTSCAN_ENV=dev
OPTSCAN_LOG_LEVEL=INFO
OPTSCAN_LOG_FORMAT=console

# yfinance needs no credentials. Switch to tradier or schwab in Phase 5.
OPTSCAN_PROVIDER=yfinance

# Storage. Relative paths resolve against the repo root.
OPTSCAN_DATA_DIR=data

# Pricing assumptions used by our own greeks. Annualized, decimal not percent.
OPTSCAN_RISK_FREE_RATE=0.043

# Market calendar. Everything time related resolves through this, including which
# session a capture belongs to and whether the snapshot job runs at all.
OPTSCAN_MARKET_CALENDAR=NYSE
OPTSCAN_MARKET_TIMEZONE=America/New_York

# Daily snapshot. The time is in market local time, not machine time, and the
# scheduler converts it. Consistency matters more than the exact value: IV rank
# compares today against history sampled at the same point in the session.
OPTSCAN_SNAPSHOT_TIME_LOCAL=15:45
OPTSCAN_SNAPSHOT_MAX_DTE=400
OPTSCAN_SNAPSHOT_MAX_EXPIRIES=16

# Seeded into the watchlist only when the database is first created. Comma separated.
OPTSCAN_DEFAULT_WATCHLIST=SPY,QQQ,IWM,AAPL,MSFT,NVDA

# Broker credentials. Leave blank until Phase 5. Never commit real values.
OPTSCAN_TRADIER_TOKEN=
OPTSCAN_SCHWAB_CLIENT_ID=
OPTSCAN_SCHWAB_CLIENT_SECRET=

# API server
OPTSCAN_API_HOST=127.0.0.1
OPTSCAN_API_PORT=8000
