# Copy to .env and edit. .env is gitignored and must stay that way.
# Every variable is optional: the defaults in src/optscan/config.py apply otherwise.

OPTSCAN_ENV=dev
OPTSCAN_LOG_LEVEL=INFO
OPTSCAN_LOG_FORMAT=console

# yfinance needs no credentials. tradier needs the token below.
OPTSCAN_PROVIDER=yfinance

# Storage. Relative paths resolve against the repo root.
OPTSCAN_DATA_DIR=data

# Pricing assumptions used by our own greeks. Annualized, decimal not percent.
OPTSCAN_RISK_FREE_RATE=0.043

# Market calendar. Everything time related resolves through this, including which
# session a capture belongs to and whether the snapshot job runs at all.
OPTSCAN_MARKET_CALENDAR=NYSE
OPTSCAN_MARKET_TIMEZONE=America/New_York

# Daily snapshot. The time is in market local time, not machine time, and the
# scheduler converts it. Consistency matters more than the exact value: IV rank
# compares today against history sampled at the same point in the session.
OPTSCAN_SNAPSHOT_TIME_LOCAL=15:45
OPTSCAN_SNAPSHOT_MAX_DTE=400
OPTSCAN_SNAPSHOT_MAX_EXPIRIES=16

# How long after the capture the recording job runs. Recording scores the stored
# snapshot, so it has to be after it: run it first and it scores yesterday's chain.
OPTSCAN_RECORD_DELAY_MINUTES=30

# When settlement runs, in market local time. Before the open on purpose. Settling on
# expiry day itself asks the vendor for a close it has not published yet.
OPTSCAN_RESOLVE_TIME_LOCAL=08:00

# Minutes between runs of the position manager, when it is scheduled. It is not
# installed by default: see `optscan schedule` for why.
OPTSCAN_MANAGE_INTERVAL_MINUTES=15

# Backups. Unset means a sibling of the repo, `../optscan-backups`, because a backup
# inside data/ dies with data/. Point this at another drive or a synced folder to get
# a copy that survives losing this disk; `optscan backup` says which one you have.
# OPTSCAN_BACKUP_DIR=D:/optscan-backups

# How many dated database copies to keep. The parquet mirror is never rotated.
OPTSCAN_BACKUP_KEEP=30

# Seeded into the watchlist only when the database is first created. Comma separated.
OPTSCAN_DEFAULT_WATCHLIST=SPY,QQQ,IWM,AAPL,MSFT,NVDA

# Broker credentials. Never commit real values.
# A free Tradier sandbox token comes from developer.tradier.com. Only a person can
# create one, and it is the single thing this project cannot set up for itself.
OPTSCAN_TRADIER_TOKEN=
OPTSCAN_SCHWAB_CLIENT_ID=
OPTSCAN_SCHWAB_CLIENT_SECRET=

# Tradier environment. sandbox is free and documented as fifteen minutes delayed.
# production needs a funded brokerage account.
OPTSCAN_TRADIER_ENVIRONMENT=sandbox

# Set this only if the production account genuinely carries a real time market data
# entitlement. Nothing in a Tradier response says whether it does, so the code asks
# rather than guessing, and false is the answer that cannot mislead. Ignored in
# sandbox, which is delayed no matter what this says.
OPTSCAN_TRADIER_REALTIME_ENTITLED=false

# Documented market data limit: 120 a minute in production, 60 in sandbox.
OPTSCAN_TRADIER_REQUESTS_PER_MINUTE=60

# Live feed. Off by default: with this false the dashboard is exactly the stored
# snapshot tool that Phases 0 to 4 built, and nothing polls anything.
OPTSCAN_LIVE_ENABLED=false

# Seconds between refreshes of a subscribed symbol while the market is open. Each
# cycle costs one quote plus one chain, so 15 seconds spends 8 of the 60 sandbox
# requests a minute on one symbol. Nothing is polled while the market is closed.
OPTSCAN_LIVE_POLL_SECONDS=15
OPTSCAN_LIVE_OFFHOURS_POLL_MULTIPLE=8
OPTSCAN_LIVE_CHAIN_TTL_SECONDS=5
OPTSCAN_LIVE_MAX_SYMBOLS=4
OPTSCAN_LIVE_IDLE_TIMEOUT_SECONDS=60

# API server
OPTSCAN_API_HOST=127.0.0.1
OPTSCAN_API_PORT=8000
